---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
    <section class="account-page">
        <div class="account-container">
            <!-- User Profile Card -->
            <article class="profile-card">
                <div class="profile-header">
                    <img
                        id="profile-avatar"
                        class="profile-avatar"
                        src=""
                        alt="Profile picture"
                    />
                    <div class="profile-info">
                        <h2 id="display-name">Loading...</h2>
                        <p id="username" class="username"></p>
                        <p id="user-email" class="user-email"></p>
                    </div>
                </div>

                <div class="profile-actions">
                    <button id="edit-profile-btn" class="action-button secondary">Edit Profile</button>
                    <button id="logout-btn" class="action-button danger">Sign Out</button>
                </div>
            </article>

            <!-- Edit Profile Modal -->
            <div id="edit-modal" class="modal hidden">
                <div class="modal-backdrop"></div>
                <div class="modal-content">
                    <h3>Edit Profile</h3>
                    <form id="edit-form">
                        <div class="form-group">
                            <label for="edit-display-name">Display Name</label>
                            <input
                                type="text"
                                id="edit-display-name"
                                class="form-input"
                                placeholder="Your name"
                            />
                        </div>
                        <div class="form-group">
                            <label for="edit-username">Username</label>
                            <input
                                type="text"
                                id="edit-username"
                                class="form-input"
                                placeholder="username"
                            />
                        </div>
                        <div class="modal-actions">
                            <button type="button" id="cancel-edit" class="action-button secondary">Cancel</button>
                            <button type="submit" class="action-button primary">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- User's Articles Section -->
            <section class="articles-section">
                <header class="section-header">
                    <h2>Your Articles</h2>
                    <a href={`${import.meta.env.BASE_URL}write`} class="write-link">Write New Article</a>
                </header>
                <div id="articles-grid" class="articles-grid">
                    <p class="loading">Loading your articles...</p>
                </div>
                <div id="no-articles" class="no-articles hidden">
                    <p>You haven't written any articles yet.</p>
                    <a href="/write" class="action-button primary">Write Your First Article</a>
                </div>
            </section>
        </div>
    </section>

</BaseLayout>